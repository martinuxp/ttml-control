<Window
    x:Class="TtmlControl.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TtmlControl.App"
    Title="TTML Control">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox
                x:Name="SearchBox"
                PlaceholderText="Buscar por título, artista, compositor, ISRC o letra"
                QueryIcon="Find"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="FilterBox" Grid.Column="1" MinWidth="190" SelectedIndex="0" SelectionChanged="FilterBox_SelectionChanged">
                <ComboBoxItem Content="Todas" Tag="All" />
                <ComboBoxItem Content="Borrador" Tag="Draft" />
                <ComboBoxItem Content="En progreso" Tag="InProgress" />
                <ComboBoxItem Content="Completo" Tag="Complete" />
                <ComboBoxItem Content="Subido" Tag="Uploaded" />
                <ComboBoxItem Content="Con cambios sin subir" Tag="PendingChanges" />
                <ComboBoxItem Content="Sin identificar" Tag="Unidentified" />
                <ComboBoxItem Content="Con problemas" Tag="Problems" />
            </ComboBox>
            <DropDownButton x:Name="StatusButton" Grid.Column="2" Content="Marcar como" IsEnabled="False">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Borrador" Tag="Draft" Click="SetStatus_Click" />
                        <MenuFlyoutItem Text="En progreso" Tag="InProgress" Click="SetStatus_Click" />
                        <MenuFlyoutItem Text="Completo" Tag="Complete" Click="SetStatus_Click" />
                        <MenuFlyoutItem Text="Subido" Tag="Uploaded" Click="SetStatus_Click" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <Button Grid.Column="3" Content="Añadir carpeta" Click="AddFolder_Click" />
            <Button Grid.Column="4" Content="Carpetas" Click="ManageFolders_Click" />
            <Button x:Name="ScanButton" Grid.Column="5" Content="Escanear" Style="{StaticResource AccentButtonStyle}" Click="Scan_Click" />
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind local:MainWindow.HasText(ViewModel.Message), Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="Informational" />

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,0,12,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <HyperlinkButton Padding="0" Content="Título" Tag="Title" Click="Sort_Click" />
                    <HyperlinkButton Grid.Column="1" Padding="0" Content="Artista" Tag="Artist" Click="Sort_Click" />
                    <HyperlinkButton Grid.Column="2" Padding="0" Content="Estado" Tag="Status" Click="Sort_Click" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="Sync" />
                    <HyperlinkButton Grid.Column="4" Padding="0" Content="Última edición" Tag="LastEdited" Click="Sort_Click" />
                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="Vers." />
                </Grid>

                <ListView
                    x:Name="SongList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Songs}"
                    SelectionChanged="SongList_SelectionChanged"
                    SelectionMode="Extended">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:SongRow">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE7BA;" Visibility="{x:Bind HasProblems}" ToolTipService.ToolTip="{x:Bind Problems}" />
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Artists}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind StatusText}" />
                                    <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="Con cambios" Visibility="{x:Bind HasPendingChanges}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind Sync}" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind LastEdited}" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind VersionCount}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="Añade una carpeta con tus TTML para empezar."
                    Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}" />
            </Grid>

            <ScrollViewer Grid.Column="1">
                <StackPanel x:Name="DetailPanel" Spacing="10" Visibility="Collapsed">
                    <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="DetailMetadata" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="EditButton" Content="Editar datos" Click="EditIdentity_Click" />
                        <Button x:Name="OpenFileButton" Content="Abrir" Click="OpenFile_Click" />
                        <Button x:Name="ShowFileButton" Content="Mostrar en carpeta" Click="ShowFile_Click" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Archivos" />
                    <TextBlock x:Name="DetailFiles" TextWrapping="Wrap" FontSize="12" IsTextSelectionEnabled="True" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Letra" />
                    <TextBlock x:Name="DetailLyrics" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Content="Cancelar escaneo" Click="CancelScan_Click" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
